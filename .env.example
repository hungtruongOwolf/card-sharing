# Copy to .env for LOCAL DEVELOPMENT ONLY. Never commit .env; never reuse these values in any
# shared environment. Real environments get secrets from the platform secret manager.

# --- apps/api (Rust) -------------------------------------------------------------------
API_BIND_ADDR=127.0.0.1:8080
# Exact origins, comma-separated. Empty = no browser cross-origin access (deny by default).
API_CORS_ALLOWED_ORIGINS=http://localhost:3000
API_REQUEST_TIMEOUT_SECS=15
API_BODY_LIMIT_BYTES=1048576
API_POLICY_CONFIG_PATH=config/policy/regions.yaml
# json | pretty
API_LOG_FORMAT=pretty
RUST_LOG=info,api=debug,tower_http=info
API_DB_MAX_CONNECTIONS=10
# AEAD key for personal-data columns (DOB). LOCAL VALUE ONLY (32 zero bytes); real environments get a
# random key from the secret manager: openssl rand -base64 32
API_DATA_ENCRYPTION_KEY=AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=
# Rate limits per route (SR-23).
API_LIMITS_CONFIG_PATH=config/limits.yaml
# Header the edge proxy sets to the client IP (e.g. fly-client-ip). Leave empty locally: the TCP
# peer address is used. Never set it unless every request passes through a proxy that overwrites it.
API_CLIENT_IP_HEADER=
# Header a trusted edge sets to the client's ISO country (e.g. cf-ipcountry behind Cloudflare). Empty =
# no IP-country signal for region policy (store/declared country and stored signals still apply).
API_IP_COUNTRY_HEADER=
# Public client config served by GET /v1/config (min app version, limits, flags, kill switches).
API_CLIENT_CONFIG_PATH=config/client.yaml
# Text filter for names/captions (sanitizer + term lists) and profile rules (display name, handle grace/cooldown/reserved).
API_TEXT_FILTER_CONFIG_PATH=config/text_filter.yaml
API_PROFILE_CONFIG_PATH=config/profile.yaml
API_SOCIAL_CONFIG_PATH=config/social.yaml
# Media object storage (T-70): filesystem root for local development (<dir>/<bucket>/<key>, git-ignored).
# Empty = no storage: uploads answer 503 and media jobs wait (fail closed).
API_MEDIA_STORAGE_DIR=.data/media
# S3-compatible media storage (#251): Cloudflare R2 in production, or the compose MinIO locally. Set
# API_S3_ENDPOINT instead of API_MEDIA_STORAGE_DIR (not both); plain http:// only when API_ENV is not
# production. Keys come from the secret manager; never commit values.
# API_S3_ENDPOINT=http://127.0.0.1:9000
# API_S3_REGION=us-east-1
# API_S3_ACCESS_KEY_ID=
# API_S3_SECRET_ACCESS_KEY=
# API_S3_BUCKET_QUARANTINE=quarantine
# API_S3_BUCKET_CLEAN=clean
# API_S3_BUCKET_LEGAL_HOLD=legal-hold
# Deployment profile (T-72): development | test | staging | production (default when unset). Fake
# content-safety adapters refuse to start in production.
API_ENV=development
# Known-CSAM hash matcher (T-72): none (default: every scan waits, nothing is delivered) | fake
# (magenta top-left pixel = test match, cyan = outage). Real vendors pending EM decision.
API_CSAM_MATCHER=fake
# Nudity classifier (T-73): none (default: card renders and avatars wait) | fake (yellow top-left pixel =
# flagged, blue = outage). Hold threshold in (0, 1], default 0.5 (EM decision pending).
API_NUDITY_CLASSIFIER=fake
API_NUDITY_THRESHOLD=0.5
# Signed media URLs (T-74): HMAC key (secret, >= 32 bytes base64; dev-only value below) and where the clean
# bucket is served (the API's own edge route locally, the CDN in production).
API_MEDIA_SIGNING_KEY=AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=
API_MEDIA_BASE_URL=http://127.0.0.1:8080/v1/media-files
# Sign in with Apple (T-19). Accepted `aud` values of Apple ID tokens: the iOS bundle id (comma-separated
# if more). Empty = POST /v1/auth/apple answers 503.
API_APPLE_CLIENT_IDS=
# Sign in with Google (T-20). Accepted `aud` values of Google ID tokens (the OAuth client ids the apps request
# tokens for, comma-separated). Empty = POST /v1/auth/google answers 503.
API_GOOGLE_CLIENT_IDS=
# Tolerance in seconds for ID-token exp/nbf/iat (0..300).
API_AUTH_CLOCK_SKEW_SECS=60
# Apple team key (.p8) for exchanging authorization codes into refresh tokens (revoked on account
# deletion). All three or none; the private key comes from the secret manager, never from this file.
API_APPLE_TEAM_ID=
API_APPLE_KEY_ID=
API_APPLE_PRIVATE_KEY=
# OS age signals (POST /v1/me/age-signal): off until legal review L-3.
API_OS_AGE_SIGNALS_ENABLED=false
# Device attestation (att routes): off | log_only (beta) | enforce (GA).
API_ATTESTATION_MODE=log_only
API_APP_ATTEST_APP_IDS=
API_APP_ATTEST_ALLOW_DEVELOPMENT=false
# Play Console response encryption keys: all three or none (secrets from the secret manager).
API_PLAY_INTEGRITY_PACKAGE_NAMES=
API_PLAY_INTEGRITY_DECRYPTION_KEY=
API_PLAY_INTEGRITY_VERIFICATION_KEY=
# Outgoing mail (magic links): none | smtp (Mailpit, local only) | postmark.
API_MAIL_TRANSPORT=smtp
API_SMTP_HOST=127.0.0.1
API_SMTP_PORT=1025
API_MAIL_FROM=no-reply@cardsharing.local
API_POSTMARK_SERVER_TOKEN=
API_MAGIC_LINK_URL=http://localhost:3000/auth/link
# Credential shared with the web server (apps/web) for /v1/public/* (auth kind svc), sent as
# X-Service-Credential. At least 32 printable characters (openssl rand -base64 32), from the secret
# manager; never commit a value. Empty = every svc route answers 401.
API_SERVICE_CREDENTIAL=

# --- apps/web (Next.js) ----------------------------------------------------------------
# Public origin for absolute OG URLs. Server-only (no NEXT_PUBLIC_ prefix).
SITE_URL=http://localhost:3000
# Invite landing (/i/<token>): server-side calls to the API's /v1/public/* routes. Server-only; never
# prefix these with NEXT_PUBLIC_. API_SERVICE_CREDENTIAL above is the same secret (from the secret
# manager in shared environments). Without both, the page shows "could not open this invite".
API_URL=http://127.0.0.1:8080
# Header the edge proxy overwrites with the visitor IP (e.g. fly-client-ip). Empty = every visitor
# shares one rate-limit bucket (a forged X-Forwarded-For is never trusted).
CLIENT_IP_HEADER=
# Optional https store links for "Get the app"; empty = the button points to the home page.
APP_STORE_URL=
PLAY_STORE_URL=

# --- infra/docker-compose.yml (local services) -------------------------------------------
POSTGRES_USER=cardsharing
POSTGRES_PASSWORD=change-me-local-only
POSTGRES_DB=cardsharing
POSTGRES_PORT=5432
# Required by the API. Shared environments use TLS (sslmode=require) and a least-privilege role (ADR-0008).
DATABASE_URL=postgres://cardsharing:change-me-local-only@127.0.0.1:5432/cardsharing

VALKEY_PASSWORD=change-me-local-only
VALKEY_PORT=6379
# Required by the API (rate limits, session cache). rediss:// (TLS) in shared environments.
REDIS_URL=redis://:change-me-local-only@127.0.0.1:6379/0

# S3-compatible object storage (MinIO-compatible). Root user must be >= 3 chars, password >= 8.
S3_ROOT_USER=cardsharing
S3_ROOT_PASSWORD=change-me-local-only
S3_API_PORT=9000
S3_CONSOLE_PORT=9001

# Integration tests (cargo test) read these; CI sets REQUIRE_INTEGRATION_TESTS=1 so they cannot be
# skipped there. Locally, unset = those tests are skipped. Point them at the compose services.
TEST_DATABASE_URL=postgres://cardsharing:change-me-local-only@127.0.0.1:5432/cardsharing
TEST_REDIS_URL=redis://:change-me-local-only@127.0.0.1:6379/0

MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025
