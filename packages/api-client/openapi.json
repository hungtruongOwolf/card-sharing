{
  "openapi": "3.1.0",
  "info": {
    "title": "card-sharing API",
    "description": "Errors use RFC 9457 application/problem+json (schema: ProblemDetails). Every operation carries `x-policy` (auth kind, role, attestation) from its deny-by-default route policy.",
    "license": {
      "name": "UNLICENSED",
      "identifier": "UNLICENSED"
    },
    "version": "0.1.0"
  },
  "paths": {
    "/healthz": {
      "get": {
        "tags": [
          "ops"
        ],
        "summary": "Liveness: the process is up. Never depends on downstream services.",
        "operationId": "healthz",
        "responses": {
          "200": {
            "description": "Process is alive. Auth: public.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            }
          }
        },
        "security": [
          {}
        ],
        "x-policy": {
          "attestation": false,
          "auth": "none",
          "rateLimit": null,
          "role": "guest",
          "versionGate": false
        }
      }
    },
    "/readyz": {
      "get": {
        "tags": [
          "ops"
        ],
        "summary": "Readiness: the instance can serve traffic (config loaded; DB/Redis checks join here later).",
        "operationId": "readyz",
        "responses": {
          "200": {
            "description": "Ready to serve traffic. Auth: public.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReadinessResponse"
                }
              }
            }
          }
        },
        "security": [
          {}
        ],
        "x-policy": {
          "attestation": false,
          "auth": "none",
          "rateLimit": null,
          "role": "guest",
          "versionGate": false
        }
      }
    },
    "/v1/auth/refresh": {
      "post": {
        "tags": [
          "auth"
        ],
        "summary": "Rotate a refresh token. Auth: none (the refresh token in the body is the credential).",
        "operationId": "refreshSession",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RefreshRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "New token pair; the presented refresh token is now used up.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TokenPair"
                }
              }
            }
          },
          "400": {
            "description": "VALIDATION_FAILED (unknown fields are rejected).",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "401": {
            "description": "UNAUTHENTICATED (unknown token) or SESSION_REVOKED (reused, revoked or ended session: sign in again).",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "429": {
            "description": "RATE_LIMITED.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "503": {
            "description": "TEMPORARILY_UNAVAILABLE (rate-limit store down; auth fails closed).",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        },
        "security": [
          {}
        ],
        "x-policy": {
          "attestation": false,
          "auth": "none",
          "rateLimit": "auth.refresh",
          "role": "guest",
          "versionGate": true
        }
      }
    },
    "/v1/config": {
      "get": {
        "tags": [
          "config"
        ],
        "summary": "Limits, feature flags and registry kill switches. Auth: none.",
        "operationId": "getConfig",
        "responses": {
          "200": {
            "description": "Public client configuration (cacheable, no user data).",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AppConfigResponse"
                }
              }
            }
          },
          "429": {
            "description": "RATE_LIMITED.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        },
        "security": [
          {}
        ],
        "x-policy": {
          "attestation": false,
          "auth": "none",
          "rateLimit": "config.read",
          "role": "guest",
          "versionGate": false
        }
      }
    },
    "/v1/me": {
      "get": {
        "tags": [
          "me"
        ],
        "summary": "My account. Auth: onb/ses.",
        "operationId": "getMe",
        "responses": {
          "200": {
            "description": "The caller's own account.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MeResponse"
                }
              }
            }
          },
          "401": {
            "description": "UNAUTHENTICATED, SESSION_EXPIRED or SESSION_REVOKED.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "426": {
            "description": "UPGRADE_REQUIRED (X-App-Version below the minimum).",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "x-policy": {
          "attestation": false,
          "auth": "onb/ses",
          "rateLimit": "me.read",
          "role": "user",
          "versionGate": true
        }
      }
    },
    "/v1/sessions/current": {
      "delete": {
        "tags": [
          "auth"
        ],
        "summary": "Log out this device: revokes the current session (and its widget token). Auth: onb/ses.",
        "operationId": "deleteCurrentSession",
        "responses": {
          "204": {
            "description": "Session revoked; its tokens stop working immediately."
          },
          "401": {
            "description": "UNAUTHENTICATED, SESSION_EXPIRED or SESSION_REVOKED.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "x-policy": {
          "attestation": false,
          "auth": "onb/ses",
          "rateLimit": "sessions.current.delete",
          "role": "user",
          "versionGate": true
        }
      }
    }
  },
  "components": {
    "schemas": {
      "AccountView": {
        "type": "object",
        "required": [
          "id",
          "status"
        ],
        "properties": {
          "id": {
            "type": "string",
            "example": "0192f0c1-7c1e-7a3b-9d2e-123456789abc"
          },
          "status": {
            "type": "string",
            "example": "pending_age"
          }
        }
      },
      "AdsView": {
        "type": "object",
        "required": [
          "rewarded",
          "personalized_requires_consent"
        ],
        "properties": {
          "personalized_requires_consent": {
            "type": "boolean"
          },
          "rewarded": {
            "type": "boolean"
          }
        }
      },
      "AiEffectsView": {
        "type": "object",
        "required": [
          "cloud_allowed",
          "people_in_photo"
        ],
        "properties": {
          "cloud_allowed": {
            "type": "boolean"
          },
          "people_in_photo": {
            "type": "string",
            "description": "`any` | `on_device_or_non_gemini` | `on_device_only`.",
            "example": "on_device_or_non_gemini"
          }
        }
      },
      "AiLabelView": {
        "type": "object",
        "required": [
          "visible_badge",
          "c2pa"
        ],
        "properties": {
          "c2pa": {
            "type": "boolean"
          },
          "visible_badge": {
            "type": "boolean"
          }
        }
      },
      "AppConfigResponse": {
        "type": "object",
        "description": "Body of `GET /v1/config`.",
        "required": [
          "min_app_version",
          "limits",
          "flags",
          "kill_switches"
        ],
        "properties": {
          "flags": {
            "type": "object",
            "additionalProperties": {
              "type": "boolean"
            },
            "propertyNames": {
              "type": "string"
            }
          },
          "kill_switches": {
            "$ref": "#/components/schemas/KillSwitches"
          },
          "limits": {
            "$ref": "#/components/schemas/ClientLimits"
          },
          "min_app_version": {
            "type": "string",
            "description": "Clients below this version must update (requests get 426 `UPGRADE_REQUIRED`).",
            "example": "0.1.0"
          }
        }
      },
      "ClientLimits": {
        "type": "object",
        "description": "Product limits shown by the app. The server enforces its own copies.",
        "required": [
          "caption_max_chars",
          "card_recipients_max",
          "friends_max",
          "boards_max",
          "pins_per_board_max",
          "board_collaborators_max"
        ],
        "properties": {
          "board_collaborators_max": {
            "type": "integer",
            "format": "int32",
            "minimum": 0
          },
          "boards_max": {
            "type": "integer",
            "format": "int32",
            "minimum": 0
          },
          "caption_max_chars": {
            "type": "integer",
            "format": "int32",
            "minimum": 0
          },
          "card_recipients_max": {
            "type": "integer",
            "format": "int32",
            "minimum": 0
          },
          "friends_max": {
            "type": "integer",
            "format": "int32",
            "minimum": 0
          },
          "pins_per_board_max": {
            "type": "integer",
            "format": "int32",
            "minimum": 0
          }
        },
        "additionalProperties": false
      },
      "HealthResponse": {
        "type": "object",
        "required": [
          "status"
        ],
        "properties": {
          "status": {
            "type": "string",
            "example": "ok"
          }
        }
      },
      "KillSwitches": {
        "type": "object",
        "description": "Registry ids switched off remotely; the app hides them and the server rejects them.",
        "required": [
          "cut_styles",
          "finishes",
          "effects",
          "reactions"
        ],
        "properties": {
          "cut_styles": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "effects": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "finishes": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "reactions": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "additionalProperties": false
      },
      "MeResponse": {
        "type": "object",
        "required": [
          "account",
          "onboarding",
          "policy"
        ],
        "properties": {
          "account": {
            "$ref": "#/components/schemas/AccountView"
          },
          "onboarding": {
            "$ref": "#/components/schemas/OnboardingView"
          },
          "policy": {
            "$ref": "#/components/schemas/PolicyView",
            "description": "Region rules that apply to this account (strictest of the signals stored at sign-up and\nthe current request). The app renders only what these allow."
          }
        }
      },
      "OnboardingStep": {
        "type": "string",
        "enum": [
          "age",
          "profile",
          "done"
        ]
      },
      "OnboardingView": {
        "type": "object",
        "required": [
          "step"
        ],
        "properties": {
          "step": {
            "$ref": "#/components/schemas/OnboardingStep"
          }
        }
      },
      "PolicyView": {
        "type": "object",
        "required": [
          "min_age",
          "ai_effects",
          "ads",
          "ai_label"
        ],
        "properties": {
          "ads": {
            "$ref": "#/components/schemas/AdsView"
          },
          "ai_effects": {
            "$ref": "#/components/schemas/AiEffectsView"
          },
          "ai_label": {
            "$ref": "#/components/schemas/AiLabelView"
          },
          "min_age": {
            "type": "integer",
            "format": "int32",
            "minimum": 0
          }
        }
      },
      "ProblemDetails": {
        "type": "object",
        "description": "RFC 9457 problem details with two extension members: `code` and `requestId`.",
        "required": [
          "type",
          "title",
          "status",
          "code"
        ],
        "properties": {
          "code": {
            "type": "string",
            "description": "Stable error code clients can switch on.",
            "example": "NOT_FOUND"
          },
          "detail": {
            "type": [
              "string",
              "null"
            ],
            "description": "Safe, human-readable explanation. Never contains internal details."
          },
          "requestId": {
            "type": [
              "string",
              "null"
            ],
            "description": "Id of the failing request (same value as the `X-Request-Id` response header).",
            "example": "0192f0c1-7c1e-7a3b-9d2e-123456789abc"
          },
          "status": {
            "type": "integer",
            "format": "int32",
            "example": 404,
            "minimum": 0
          },
          "title": {
            "type": "string",
            "example": "Not Found"
          },
          "type": {
            "type": "string",
            "description": "URI reference identifying the problem type (`about:blank` = see `status` and `code`).",
            "example": "about:blank"
          }
        }
      },
      "ReadinessChecks": {
        "type": "object",
        "required": [
          "policy_config_version"
        ],
        "properties": {
          "policy_config_version": {
            "type": "integer",
            "format": "int32",
            "description": "Version of the loaded region policy config.",
            "example": 1,
            "minimum": 0
          }
        }
      },
      "ReadinessResponse": {
        "type": "object",
        "required": [
          "status",
          "checks"
        ],
        "properties": {
          "checks": {
            "$ref": "#/components/schemas/ReadinessChecks"
          },
          "status": {
            "type": "string",
            "example": "ready"
          }
        }
      },
      "RefreshRequest": {
        "type": "object",
        "description": "Body of `POST /v1/auth/refresh`. Only the refresh token: the session (and therefore the\naccount) is derived from it, never from a client-supplied id.",
        "required": [
          "refresh_token"
        ],
        "properties": {
          "refresh_token": {
            "type": "string",
            "maxLength": 256,
            "minLength": 1
          }
        },
        "additionalProperties": false
      },
      "TokenPair": {
        "type": "object",
        "description": "A new access + refresh token pair. Store both in the device's secure storage only.",
        "required": [
          "token_type",
          "access_token",
          "access_expires_at",
          "refresh_token"
        ],
        "properties": {
          "access_expires_at": {
            "type": "string",
            "format": "date-time"
          },
          "access_token": {
            "type": "string",
            "description": "Opaque, 10 minutes. Send as `Authorization: Bearer <access_token>`."
          },
          "refresh_token": {
            "type": "string",
            "description": "Opaque, single use. Replaying a used one signs out the whole session."
          },
          "token_type": {
            "type": "string",
            "example": "Bearer"
          }
        }
      }
    },
    "securitySchemes": {
      "bearer": {
        "type": "http",
        "scheme": "bearer"
      }
    }
  },
  "tags": [
    {
      "name": "ops",
      "description": "Operational probes"
    },
    {
      "name": "auth",
      "description": "Sign-in and session lifecycle (ADR-0004)"
    },
    {
      "name": "me",
      "description": "The caller's own account and onboarding"
    },
    {
      "name": "config",
      "description": "Public client configuration"
    }
  ]
}
