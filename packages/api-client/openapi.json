{
  "openapi": "3.1.0",
  "info": {
    "title": "card-sharing API",
    "description": "Errors use RFC 9457 application/problem+json (schema: ProblemDetails). Every operation carries `x-policy` (auth kind, role, attestation) from its deny-by-default route policy.",
    "license": {
      "name": "UNLICENSED",
      "identifier": "UNLICENSED"
    },
    "version": "0.1.0"
  },
  "paths": {
    "/healthz": {
      "get": {
        "tags": [
          "ops"
        ],
        "summary": "Liveness: the process is up. Never depends on downstream services.",
        "operationId": "healthz",
        "responses": {
          "200": {
            "description": "Process is alive. Auth: public.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            }
          }
        },
        "security": [
          {}
        ],
        "x-policy": {
          "attestation": false,
          "auth": "none",
          "rateLimit": null,
          "role": "guest"
        }
      }
    },
    "/readyz": {
      "get": {
        "tags": [
          "ops"
        ],
        "summary": "Readiness: the instance can serve traffic (config loaded; DB/Redis checks join here later).",
        "operationId": "readyz",
        "responses": {
          "200": {
            "description": "Ready to serve traffic. Auth: public.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReadinessResponse"
                }
              }
            }
          }
        },
        "security": [
          {}
        ],
        "x-policy": {
          "attestation": false,
          "auth": "none",
          "rateLimit": null,
          "role": "guest"
        }
      }
    }
  },
  "components": {
    "schemas": {
      "HealthResponse": {
        "type": "object",
        "required": [
          "status"
        ],
        "properties": {
          "status": {
            "type": "string",
            "example": "ok"
          }
        }
      },
      "ProblemDetails": {
        "type": "object",
        "description": "RFC 9457 problem details with two extension members: `code` and `requestId`.",
        "required": [
          "type",
          "title",
          "status",
          "code"
        ],
        "properties": {
          "code": {
            "type": "string",
            "description": "Stable error code clients can switch on.",
            "example": "NOT_FOUND"
          },
          "detail": {
            "type": [
              "string",
              "null"
            ],
            "description": "Safe, human-readable explanation. Never contains internal details."
          },
          "requestId": {
            "type": [
              "string",
              "null"
            ],
            "description": "Id of the failing request (same value as the `X-Request-Id` response header).",
            "example": "0192f0c1-7c1e-7a3b-9d2e-123456789abc"
          },
          "status": {
            "type": "integer",
            "format": "int32",
            "example": 404,
            "minimum": 0
          },
          "title": {
            "type": "string",
            "example": "Not Found"
          },
          "type": {
            "type": "string",
            "description": "URI reference identifying the problem type (`about:blank` = see `status` and `code`).",
            "example": "about:blank"
          }
        }
      },
      "ReadinessChecks": {
        "type": "object",
        "required": [
          "policy_config_version"
        ],
        "properties": {
          "policy_config_version": {
            "type": "integer",
            "format": "int32",
            "description": "Version of the loaded region policy config.",
            "example": 1,
            "minimum": 0
          }
        }
      },
      "ReadinessResponse": {
        "type": "object",
        "required": [
          "status",
          "checks"
        ],
        "properties": {
          "checks": {
            "$ref": "#/components/schemas/ReadinessChecks"
          },
          "status": {
            "type": "string",
            "example": "ready"
          }
        }
      }
    },
    "securitySchemes": {
      "bearer": {
        "type": "http",
        "scheme": "bearer"
      }
    }
  },
  "tags": [
    {
      "name": "ops",
      "description": "Operational probes"
    }
  ]
}
