{
  "expo": {
    "name": "card-sharing",
    "slug": "card-sharing",
    "version": "0.1.0",
    "scheme": "cardsharing",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "plugins": [
      "expo-router",
      [
        "expo-secure-store",
        {
          "faceIDPermission": false
        }
      ],
      [
        "expo-image-picker",
        {
          "cameraPermission": "The camera lets you snap things and turn them into cards. Photos stay on your phone until you send a card.",
          "photosPermission": "Choose photos you already have to turn them into cards.",
          "microphonePermission": false
        }
      ],
      [
        "expo-font",
        {
          "fonts": [
            "./assets/fonts/bricolage-grotesque/BricolageGrotesque-SemiBold.ttf",
            "./assets/fonts/bricolage-grotesque/BricolageGrotesque-Bold.ttf",
            "./assets/fonts/dm-sans/DMSans-Regular.ttf",
            "./assets/fonts/dm-sans/DMSans-SemiBold.ttf",
            "./assets/fonts/caveat/Caveat-Medium.ttf",
            "./assets/fonts/anton/Anton-Regular.ttf",
            "./assets/fonts/dm-mono/DMMono-Medium.ttf"
          ]
        }
      ]
    ]
  }
}
