# Copy to apps/mobile/.env for local development. Every EXPO_PUBLIC_* value is inlined into the app
# bundle and readable by anyone: public values only, never secrets.
#
# API base URL. Release builds require https. Development builds may use http to localhost, the Android
# emulator host (10.0.2.2) or your computer's LAN IP when testing on a phone over Wi-Fi.
EXPO_PUBLIC_API_URL=http://localhost:8080
#
# Google Sign-In on the web (ADR-0012): the OAuth 2.0 client id of a "Web application" client (public, not a secret).
# Empty = the Google button is hidden. The API must accept the same id: add it to API_GOOGLE_CLIENT_IDS. Google allows
# plain-http JavaScript origins only for http://localhost, so on http://<pc-lan-ip>:8081 the button cannot work.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
