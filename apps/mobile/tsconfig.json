{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "types": ["jest"],
    "paths": {
      "@card-sharing/tokens": ["../../packages/tokens/src/index.ts"],
      "@card-sharing/shaders": ["../../packages/shaders/src/index.ts"],
      "@card-sharing/api-client": ["../../packages/api-client/src/index.ts"],
      "@card-sharing/effects-registry": ["../../packages/effects-registry/src/index.ts"],
      "@card-sharing/canvas-engine": ["../../packages/canvas-engine/src/index.ts"]
    }
  },
  "include": ["**/*.ts", "**/*.tsx", ".expo/types/**/*.ts", "expo-env.d.ts"]
}
